# MySQL Database Settings (used by docker-compose.yml)
MYSQL_DATABASE=dream_shops
MYSQL_ROOT_PASSWORD=change_me_root_password

# Base64-encoded secret (>= 32 bytes / 256 bits) for HS256 JWT signing
# Generate in PowerShell:
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=replace_with_your_base64_256bit_secret_key=

# Token expiration in milliseconds (default: 3600000 = 1 hour)
JWT_EXPIRATION=3600000
